OPENAI_API_KEY=
OPENAI_BASE_URL=
LANGSMITH_API_KEY=
LANGSMITH_TRACING="true"
LANGSMITH_PROJECT="distributed-tracing"
# if on EU instance, otherwise leave commented out
#LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Harness settings (all optional) ---
# Model served by the OpenAI-compatible gateway above. Must support tool calling.
#HARNESS_MODEL=gpt-4.1-mini
# Case 6: second project in the same workspace (defaults to <LANGSMITH_PROJECT>-replica)
#HARNESS_REPLICA_PROJECT=
# Cases 6e/6f: a key for a DIFFERENT workspace, and the project to replicate into there
LANGSMITH_API_KEY_REPLICA=
#HARNESS_REPLICA_WS_PROJECT=
#LANGSMITH_REPLICA_ENDPOINT=https://api.smith.langchain.com
# Run cases against deployed services instead of local ones (see README, "Deploy the child")
#HARNESS_CHILD_URL=
#HARNESS_MCP_URL=
